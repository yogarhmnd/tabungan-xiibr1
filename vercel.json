{
  version: 2,
  name: tabungan-xiipm1,
  alias: [
    tabungan-xiipm1.vercel.app
  ],
  cleanUrls: true,
  trailingSlash: false,
  headers: [
    {
      source: /(.*),
      headers: [
        {
          key: X-Content-Type-Options,
          value: nosniff
        },
        {
          key: X-Frame-Options,
          value: DENY
        },
        {
          key: X-XSS-Protection,
          value: 1; mode=block
        }
      ]
    },
    {
      source: /(.*).(css|js|png|svg|ico|jpg|jpeg|webp),
      headers: [
        {
          key: Cache-Control,
          value: public, max-age=31536000, immutable
        }
      ]
    }
  ]
}
